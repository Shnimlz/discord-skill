{
  "name": "discord-skill",
  "version": "1.0.0",
  "description": "Cross-runtime Agent Skill & Developer CLI for the entire Discord.js and Discord API ecosystem",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "discord-skill": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint",
    "cli": "tsx src/cli/index.ts",
    "audit": "tsx src/cli/index.ts audit",
    "diff": "tsx src/cli/index.ts diff",
    "extract": "tsx src/cli/index.ts extract",
    "baseline": "tsx src/cli/index.ts baseline"
  },
  "keywords": [
    "discord",
    "discord.js",
    "discord-api",
    "agent-skill",
    "antigravity",
    "claude-skill",
