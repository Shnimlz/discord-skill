    "bot-development",
    "reverse-engineering"
  ],
  "author": "DDC & Bot Developer Community",
  "license": "MIT",
  "devDependencies": {
    "@discordjs/brokers": "^0.2.1",
    "@discordjs/builders": "^1.11.0",
    "@discordjs/collection": "^2.1.1",
    "@discordjs/core": "^2.6.0",
    "@discordjs/formatters": "^0.6.0",
    "@discordjs/proxy": "^1.1.0",
    "@discordjs/rest": "^2.6.3",
    "@discordjs/voice": "^0.18.0",
    "@discordjs/ws": "^2.0.4",
    "@types/node": "^22.0.0",
    "discord-api-types": "^0.37.119",
    "discord.js": "^14.26.5",
    "@oxlint/plugins": "1.88.0",
    "oxlint": "1.88.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
